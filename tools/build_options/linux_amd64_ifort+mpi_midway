FC=mpiifort
CC=mpiicc
F90C=mpiifort

DEFINES='-DALLOW_USE_MPI -DALWAYS_USE_MPI -DWORDLENGTH=4'
CPP='/lib/cpp  -traditional -P'
EXTENDED_SRC_FLAG='-132'
OMPFLAG='-openmp'
CFLAGS='-fPIC'
LDADD='-shared-intel'

LIBS="-L${NETCDF_DIR}/lib -L${I_MPI_ROOT}/intel64/lib -lmpi -lnetcdf"
INCLUDES="-I${NETCDF_DIR}/include -I${I_MPI_ROOT}/intel64/include"

NOOPTFLAGS='-O0 -fPIC'

FFLAGS="-fPIC -convert big_endian -assume byterecl -align -march=corei7 -axAVX"
FDEBUG='-W0 -WB'
FFLAGS="$FDEBUG $FFLAGS"

FOPTIM='-O2'
FOPTIM="$FOPTIM -ip -fp-model precise -traceback -ftz"

